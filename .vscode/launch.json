    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug LLDB",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Pick Process Attach",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}" // Or pickMyProcess for only processes for the current user.
        }
        
    ]
}
